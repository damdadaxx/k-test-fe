NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
BACKEND_URL=http://00.00.0.000:3000

# 백엔드 vendor 다운 시 개발용 우회 (각 단계 verify/detect 건너뜀). 운영은 false.
NEXT_PUBLIC_SKIP_FACE_VERIFY=false
NEXT_PUBLIC_SKIP_EAR_DETECT=false

# 개발용: 세션시작 POST 건너뛰고 이 examSessionId로 바로 진입(재개 카운트/BLOCKED 방지). 운영 비움.
NEXT_PUBLIC_DEV_SESSION_ID=


# 개발용: 진입 가드(종료/차단 세션 차단) 우회. 운영 비움.
NEXT_PUBLIC_DEV_SKIP_SESSION_GUARD=false

# 프록토링 웹캠 프레임 전송(monitoring/analyze) 주기(ms). 비우면 기본 10000.
NEXT_PUBLIC_PROCTOR_INTERVAL_MS=

# 개발용: true면 웹캠 취득·프레임 전송을 통째로 끔(analyze 부하 방지). 운영 false/비움.
NEXT_PUBLIC_PROCTOR_DISABLED=false

# 개발용: true면 시험 중 뒤로가기 차단을 끔. 운영 false/비움.
NEXT_PUBLIC_BACK_BLOCK_DISABLED=false
